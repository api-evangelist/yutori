{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast Browsing Health API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.yutori.com/v1/health"
          },
          "docs": "Health"
        }
      ]
    }
  ],
  "bundled": true
}